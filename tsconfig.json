{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"],
  // `src/worker.ts` is the Cloudflare Worker connector entrypoint. It imports
  // `agents` / `@chrischall/mcp-connector` (which resolve `cloudflare:workers`,
  // unavailable to the Node `tsc` build) and is bundled by wrangler, not tsc.
  // Excluding it keeps the stdio build from emitting `dist/worker.js`.
  "exclude": ["node_modules", "dist", "src/worker.ts"]
}
