SETLIST_API_KEY=your_api_key_here
# Optional: localize city/country names (one of: en, es, fr, de, pt, tr, it, pl)
# SETLIST_ACCEPT_LANGUAGE=en
# Optional: ONLY for the attendance write tools (setlist_mark_attended / _unmark_attended).
# The Cookie header from a logged-in www.setlist.fm request (DevTools → Network → Request Headers → Cookie).
# SETLIST_SESSION_COOKIE=JSESSIONID=...; RememberMeCookie=...; aws-waf-token=...
