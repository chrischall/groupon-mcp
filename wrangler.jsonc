{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "groupon-connector",
  "main": "src/worker.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The connector is STATELESS — the only Durable Object is the harness's
  // per-session MCP agent (`GrouponMcpAgent`). Groupon's read surface needs no
  // cache, so there is no cache Durable Object here.
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "GrouponMcpAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GrouponMcpAgent"] }],
  // groupon-connector's own OAuth token store (title: groupon-connector-oauth).
  // Kept separate from any other connector's OAUTH_KV so their OAuth grants/tokens
  // never cross-wire. To stand up a deployment, create your own
  // (wrangler kv namespace create groupon-connector-oauth) and replace this id.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_OAUTH_KV_NAMESPACE_ID" }],
  // Production custom domain (matches the fleet's connector.<service>.nullnet.app
  // convention). The zone must be in the deploying account's Cloudflare; wrangler
  // provisions the hostname on deploy. Remove this route to deploy to
  // *.workers.dev only.
  "routes": [{ "pattern": "connector.groupon.nullnet.app", "custom_domain": true }],
  "workers_dev": true,
  // Optional read-tuning var the GrouponClient env-gates (seconds; 0 = off).
  // Groupon deal reads need no credential, so there are no secret vars here.
  "vars": {
    "GROUPON_CACHE_TTL": "60"
  },
  "observability": {
    "enabled": true
  }
}
