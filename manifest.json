{
  "$schema": "https://raw.githubusercontent.com/anthropics/dxt/main/dist/mcpb-manifest.schema.json",
  "manifest_version": "0.3",
  "name": "groupon-mcp",
  "display_name": "Groupon",
  "version": "0.1.3",
  "description": "Groupon deals for Claude — search and browse local, goods, and travel deals via natural language",
  "author": {
    "name": "Chris Chall",
    "email": "chris.c.hall@gmail.com",
    "url": "https://github.com/chrischall"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chrischall/groupon-mcp"
  },
  "homepage": "https://github.com/chrischall/groupon-mcp",
  "support": "https://github.com/chrischall/groupon-mcp/issues",
  "license": "MIT",
  "keywords": [
    "groupon",
    "deals",
    "coupons",
    "discounts",
    "local"
  ],
  "server": {
    "type": "node",
    "entry_point": "dist/bundle.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/bundle.js"
      ]
    }
  },
  "tools": [
    {
      "name": "groupon_healthcheck",
      "description": "Report that the groupon-mcp server is running and its version"
    }
  ],
  "compatibility": {
    "platforms": [
      "darwin",
      "win32"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  }
}
